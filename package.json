{
  "name": "gtd-on-rails",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "docker compose -f infra/compose.yaml up -d --wait postgres && turbo run dev",
    "dev:reset": "docker compose -f infra/compose.yaml down --volumes --remove-orphans && docker compose -f infra/compose.yaml up -d --wait postgres && turbo run dev",
    "build": "turbo run build",
    "build:prod": "pnpm --filter @gtd-on-rails/desktop run desktop:build:prod",
    "build:staging": "pnpm --filter @gtd-on-rails/desktop run desktop:build:staging",
    "agent:driver": "pnpm --filter @gtd-on-rails/desktop run agent:driver",
    "staging": "pnpm --filter @gtd-on-rails/desktop run desktop:staging",
    "test": "pnpm run unitTest && pnpm run integrationTest && pnpm run e2e",
    "frontend:coverage": "pnpm --filter @gtd-on-rails/desktop run coverage",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "demo:reset": "node scripts/demo-reset.mjs",
    "unitTest": "pnpm run version:test && turbo run unitTest",
    "integrationTest": "turbo run integrationTest",
    "version:sync": "node scripts/sync-version.mjs sync",
    "version:check": "node scripts/sync-version.mjs check",
    "version:test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
