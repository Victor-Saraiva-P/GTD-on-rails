{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTD on Rails",
  "version": "1.0.0",
  "identifier": "com.gtdonrails.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTD on Rails",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQjRFNjFGOUVENTU0OTAKUldTUVZOV2VIK2Ewd1QrUXJqdGJOdFV4cDZ3UUVuREFORGhXYUhIcDJYcG9aWThBQitPY0E1aGgK",
      "endpoints": [
        "https://github.com/Victor-Saraiva-P/GTD-on-rails/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/gtd-api"],
    "resources": ["binaries"],
    "targets": "all"
  }
}
